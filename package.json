{
  "name": "outagekit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Outagekit: battery runtime calculator and outage plan for people who depend on electric medical equipment.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobojoel2003/Outagekit.git"
  },
  "scripts": {
    "build": "pnpm -r --filter @outagekit/runtime build && pnpm --filter @outagekit/web build",
    "dev": "pnpm --filter @outagekit/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "e2e": "pnpm --filter @outagekit/web e2e",
    "catalog:docs": "node scripts/catalog-docs.mjs",
    "version:set": "node scripts/set-version.mjs",
    "screenshots": "pnpm --filter @outagekit/web screenshots",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
