{
  "name": "@outagekit/web",
  "version": "1.0.0",
  "private": true,
  "description": "Outagekit: an offline app that tells you how long your battery will run your medical equipment, and builds a one-page outage plan.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "cap:sync": "pnpm build:android && cap sync android",
    "android:debug": "pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "pnpm cap:sync && cd android && ./gradlew assembleRelease bundleRelease",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@outagekit/runtime": "workspace:*",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
