{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "rootDir": "../..",
    "noEmit": true,
    "paths": {
      "@outagekit/runtime": ["../../packages/runtime/src/index.ts"]
    }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts", "capacitor.config.ts"]
}
