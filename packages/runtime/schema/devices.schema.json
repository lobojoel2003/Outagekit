{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lobojoel2003/Outagekit/blob/main/packages/runtime/schema/devices.schema.json",
  "title": "Outagekit device catalog",
  "type": "object",
  "required": ["updated", "devices"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "reference": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "publisher": { "type": "string" }
      },
      "additionalProperties": false
    },
    "setting": {
      "type": "object",
      "required": ["id", "label", "watts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "watts": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": [
        "id",
        "name",
        "manufacturer",
        "category",
        "supply",
        "priority",
        "settings",
        "defaultSetting",
        "dutyCycle",
        "idleWatts",
        "surgeWatts",
        "internalBattery",
        "notes",
        "sources",
        "verified"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": ["string", "null"] },
        "category": {
          "enum": [
            "oxygen-concentrator",
            "portable-oxygen-concentrator",
            "cpap",
            "bilevel",
            "ventilator",
            "bed",
            "mattress",
            "suction",
            "nebulizer",
            "feeding-pump",
            "infusion-pump",
            "dialysis",
            "mobility",
            "monitor",
            "refrigeration",
            "communication",
            "lighting",
            "climate",
            "other"
          ]
        },
        "supply": { "enum": ["ac", "dc"] },
        "priority": { "enum": ["comfort", "essential", "medical", "life-sustaining"] },
        "settings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/setting" } },
        "defaultSetting": { "$ref": "#/$defs/id" },
        "dutyCycle": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "idleWatts": { "type": "number", "minimum": 0 },
        "surgeWatts": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "internalBattery": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["hours", "note"],
              "properties": {
                "hours": { "type": "number", "exclusiveMinimum": 0 },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "notes": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "verified": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
