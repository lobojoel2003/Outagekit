{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lobojoel2003/Outagekit/blob/main/packages/runtime/schema/power-sources.schema.json",
  "title": "Outagekit power source catalog",
  "type": "object",
  "required": ["updated", "powerSources"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "powerSources": { "type": "array", "items": { "$ref": "#/$defs/powerSource" } }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "publisher": { "type": "string" }
      },
      "additionalProperties": false
    },
    "powerSource": {
      "type": "object",
      "required": [
        "id",
        "name",
        "manufacturer",
        "kind",
        "capacityWh",
        "chemistry",
        "acOutputWatts",
        "acSurgeWatts",
        "cycleLifeTo80",
        "notes",
        "sources",
        "verified"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": ["string", "null"] },
        "kind": { "enum": ["power-station", "battery-inverter", "ups"] },
        "capacityWh": { "type": "number", "exclusiveMinimum": 0 },
        "chemistry": { "enum": ["lifepo4", "nmc", "agm", "gel", "flooded"] },
        "acOutputWatts": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "acSurgeWatts": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "cycleLifeTo80": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "notes": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "verified": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
